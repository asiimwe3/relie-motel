{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(book|stay|dine|grounds|groups|explore|gallery|contact|packages)/?",
      "destination": "/$1.html"
    },
    {
      "source": "/rooms/(deluxe|double|twin)/?",
      "destination": "/rooms/$1.html"
    }
  ]
}
